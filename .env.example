SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://postgres:replace-password@localhost:5432/gov_document_management
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
VERIFICATION_BASE_URL=http://127.0.0.1:5000
MAX_VERIFICATION_PDF_SIZE=5242880
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per day;50 per hour
FABRIC_GATEWAY_URL=http://127.0.0.1:8081
FABRIC_GATEWAY_TOKEN=replace-with-a-long-random-internal-token
FABRIC_GATEWAY_TIMEOUT_SECONDS=12
